<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GraveyardOrbit.SpacePhysics/GraveyardOrbit.SpacePhysics.csproj" />
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
    <PackageReference Include="Box2D.NET" Version="3.1.654" />
    <Content Include="../../assets/asset-manifest.json" Link="assets/asset-manifest.json" />
    <Content Include="../../assets/THIRD-PARTY-NOTICES.md" Link="assets/THIRD-PARTY-NOTICES.md" />
    <Content Include="../../assets/kenney/space-shooter-remastered/PNG/playerShip1_blue.png" Link="assets/kenney/space-shooter-remastered/PNG/playerShip1_blue.png" />
    <Content Include="../../assets/kenney/space-shooter-remastered/PNG/Meteors/meteorBrown_big1.png" Link="assets/kenney/space-shooter-remastered/PNG/Meteors/meteorBrown_big1.png" />
    <Content Include="../../assets/kenney/space-shooter-remastered/PNG/Lasers/laserBlue01.png" Link="assets/kenney/space-shooter-remastered/PNG/Lasers/laserBlue01.png" />
    <Content Include="../../assets/kenney/sci-fi-sounds/Audio/laserSmall_000.ogg" Link="assets/kenney/sci-fi-sounds/Audio/laserSmall_000.ogg" />
    <Content Include="../../assets/kenney/sci-fi-sounds/Audio/explosionCrunch_000.ogg" Link="assets/kenney/sci-fi-sounds/Audio/explosionCrunch_000.ogg" />
    <Content Include="../../assets/kenney/space-shooter-remastered/license.txt" Link="assets/kenney/space-shooter-remastered/license.txt" />
    <Content Include="../../assets/kenney/space-shooter-extension/License.txt" Link="assets/kenney/space-shooter-extension/License.txt" />
    <Content Include="../../assets/kenney/sci-fi-sounds/License.txt" Link="assets/kenney/sci-fi-sounds/License.txt" />
    <Content Include="../../LICENSE" Link="LICENSE" />
    <Content Include="../../docs/licenses/*.txt" Link="docs/licenses/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <Content>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemDefinitionGroup>
</Project>
